# Copy this file to .env and fill in your values.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL connection (DB_ENGINE=sqlite is only for a quick try-out without MySQL)
DB_ENGINE=mysql
DB_NAME=lumiere_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Payment service: "mock" (default, no keys needed) or "stripe" (test mode only)
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=
